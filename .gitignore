__pycache__/
*.pyc
.venv/

# Real MySQL credentials — never commit this
config.py

# Generated at runtime — regenerated by every import run
*_analytics_report.txt
visualizations/

# User-provided input files and generated exports (CSV/Excel) — not tracked, can be
# large and are not source code. The import is manually triggered via a file dialog,
# and every input (the file you upload) and output (<dataset_name>_export.xlsx) is
# covered by these blanket rules. examples/*.csv is the one tracked exception, kept
# so the tool is runnable out of the box with a real sample dataset.
*.csv
*.xlsx
*.xls
!examples/*.csv
