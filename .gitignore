__pycache__/
.pytest_cache/
*.pyc
.venv/

# Real MySQL credentials — never commit this
config.py

# Generated at runtime — regenerated by every import run
*_analytics_report.txt
visualizations/

# User-provided input files and generated exports (CSV/Excel) — not tracked, can be
# large and are not source code. There is no bundled sample file: the import is
# manually triggered via a file dialog, and every input (the file you upload) and
# output (<dataset_name>_export.xlsx) is covered by these blanket rules.
*.csv
*.xlsx
*.xls
